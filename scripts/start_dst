#!/usr/bin/env bash
set -euo pipefail

DST_DIR="${DST_DIR:-/opt/dst}"
DST_DATA_DIR="${DST_DATA_DIR:-/data}"
DST_CLUSTER="${DST_CLUSTER:-Cluster_1}"
DST_SHARD="${DST_SHARD:-Master}"
# DST_MODS_ONLY=1：只下载/更新 Workshop mod，完成后退出，不启动服务端。
DST_MODS_ONLY="${DST_MODS_ONLY:-0}"

DST_MODS_DIR="${DST_DIR}/mods"
DST_DEFAULT_MODS_DIR="/opt/dst_default_mods"
DST_PRESET_DIR="/opt/dst_preset"
CONFIG_TEMPLATE_DIR="/opt/dst_config_templates"

USER_MODS_DIR="${DST_DATA_DIR}/user_mods"
KLEI_DIR="${DST_DATA_DIR}/DoNotStarveTogether"
CLUSTER_DIR="${KLEI_DIR}/${DST_CLUSTER}"
SHARD_DIR="${CLUSTER_DIR}/${DST_SHARD}"

PRESET_MODS_FILE="${DST_PRESET_DIR}/mods.lua"
EXTRA_MODS_FILE="${USER_MODS_DIR}/extra_mods.lua"
FINAL_MODS_FILE="${DST_MODS_DIR}/dedicated_server_mods_setup.lua"

PRESET_OVERRIDES_FILE="${DST_PRESET_DIR}/${DST_SHARD}/modoverrides.lua"
EXTRA_OVERRIDES_FILE="${USER_MODS_DIR}/${DST_SHARD}/extra_modoverrides.lua"
FINAL_OVERRIDES_FILE="${SHARD_DIR}/modoverrides.lua"

case "${DST_SHARD}" in
  Master|Caves) ;;
  *)
    echo "ERROR: unsupported DST shard: ${DST_SHARD}" >&2
    echo "Expected Master or Caves." >&2
    exit 1
    ;;
esac

if [ ! -f "${PRESET_MODS_FILE}" ]; then
  echo "ERROR: missing preset file: ${PRESET_MODS_FILE}" >&2
  echo "Mount the host preset directory at ${DST_PRESET_DIR}." >&2
  exit 1
fi

# 空 volume 会遮蔽镜像中的 mods 目录，需要先恢复服务端原始文件。
mkdir -p "${DST_MODS_DIR}"
if [ ! -f "${DST_MODS_DIR}/modsettings.lua" ]; then
  cp -a "${DST_DEFAULT_MODS_DIR}/." "${DST_MODS_DIR}/"
fi

# 生成 Workshop 下载列表：发行版 preset 拼接可选的用户 extra 文件。
if [ -f "${EXTRA_MODS_FILE}" ]; then
  cat "${PRESET_MODS_FILE}" "${EXTRA_MODS_FILE}" > "${FINAL_MODS_FILE}"
else
  cp "${PRESET_MODS_FILE}" "${FINAL_MODS_FILE}"
fi

# 只更新 mod：下载完成后服务端会自行退出。
if [ "${DST_MODS_ONLY}" = "1" ]; then
  cd "${DST_DIR}/bin"
  exec ./dontstarve_dedicated_server_nullrenderer \
    -console \
    -only_update_server_mods \
    -cluster "${DST_CLUSTER}" \
    -shard "${DST_SHARD}"
fi

# ---- 正常启动流程 ----
if [ ! -f "${PRESET_OVERRIDES_FILE}" ]; then
  echo "ERROR: missing preset file: ${PRESET_OVERRIDES_FILE}" >&2
  echo "Mount the host preset directory at ${DST_PRESET_DIR}." >&2
  exit 1
fi

mkdir -p \
  "${USER_MODS_DIR}/Master" \
  "${USER_MODS_DIR}/Caves" \
  "${CLUSTER_DIR}/Master" \
  "${CLUSTER_DIR}/Caves"

# 只初始化缺失的配置，保留用户已有内容。
if [ ! -f "${CLUSTER_DIR}/cluster.ini" ]; then
  cp "${CONFIG_TEMPLATE_DIR}/cluster.ini" "${CLUSTER_DIR}/cluster.ini"
fi

if [ ! -f "${CLUSTER_DIR}/Master/server.ini" ]; then
  cp "${CONFIG_TEMPLATE_DIR}/Master/server.ini" "${CLUSTER_DIR}/Master/server.ini"
fi

if [ ! -f "${CLUSTER_DIR}/Caves/server.ini" ]; then
  cp "${CONFIG_TEMPLATE_DIR}/Caves/server.ini" "${CLUSTER_DIR}/Caves/server.ini"
fi

# 世界生成覆盖：仅在世界生成时生效，不覆盖用户已有配置。
if [ ! -f "${SHARD_DIR}/worldgenoverride.lua" ]; then
  cp "${CONFIG_TEMPLATE_DIR}/${DST_SHARD}/worldgenoverride.lua" "${SHARD_DIR}/worldgenoverride.lua"
fi

if [ ! -s "${CLUSTER_DIR}/cluster_token.txt" ] \
  || ! grep -q '[^[:space:]]' "${CLUSTER_DIR}/cluster_token.txt"; then
  echo "ERROR: missing or empty DST cluster token." >&2
  echo >&2
  echo "Expected file:" >&2
  echo "  ${CLUSTER_DIR}/cluster_token.txt" >&2
  echo >&2
  echo "Create a DST cluster token and place it in the mounted data directory." >&2
  exit 1
fi

if [ -f "${EXTRA_OVERRIDES_FILE}" ]; then
  lua5.4 /usr/local/bin/merge_modoverrides.lua \
    "${PRESET_OVERRIDES_FILE}" \
    "${EXTRA_OVERRIDES_FILE}" \
    > "${FINAL_OVERRIDES_FILE}"
else
  cp "${PRESET_OVERRIDES_FILE}" "${FINAL_OVERRIDES_FILE}"
fi

cd "${DST_DIR}/bin"

exec ./dontstarve_dedicated_server_nullrenderer \
  -console \
  -cluster "${DST_CLUSTER}" \
  -shard "${DST_SHARD}" \
  -persistent_storage_root "${DST_DATA_DIR}" \
  -conf_dir DoNotStarveTogether
